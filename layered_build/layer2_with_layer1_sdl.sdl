type::{
  base:list,
  open_elements:true,
  elements:[
    { name:snapshot_date, doc:"Date the scores were calculated", type:{ base:timestamp, timestamp_mask:"yyyy-MM-dd", nullable:true } },
    { name:site, doc:"Warehouse site code", type:{ base:string, max_length:50, nullable:true } },
    { name:part, doc:"Amazon part number (APN)", type:{ base:string, max_length:100, nullable:true } },
    { name:region, doc:"Region (NA or EU)", type:{ base:string, max_length:10, nullable:true } },
    { name:amazon_pn, doc:"Amazon part number (alias of part)", type:{ base:string, max_length:100, nullable:true } },
    { name:part_description, doc:"Part description from catalogue", type:{ base:string, max_length:2000, nullable:true } },
    { name:cat_ref_list, doc:"Comma-separated list of catalogue references for the part", type:{ base:string, max_length:4000, nullable:true } },
    { name:product_list, doc:"Comma-separated list of products from Layer 2", type:{ base:string, max_length:5000, nullable:true } },
    { name:building_type, doc:"Building type of the site", type:{ base:string, max_length:100, nullable:true } },
    { name:sto_class, doc:"Criticality classification (01 HIGH, 02 MED, 03 LOW)", type:{ base:string, max_length:50, nullable:true } },
    { name:site_oh_qty, doc:"Current on-hand quantity at site", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:min_level, doc:"MIN replenishment level", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:max_level, doc:"MAX replenishment level", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:supplier_lead_time, doc:"Supplier lead time in days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:replenishment_time, doc:"Replenishment time in days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:source, doc:"Order-history source: AR (DWEEB) or not AR (r5)", type:{ base:string, max_length:20, nullable:true } },
    { name:order_count, doc:"Historical order count", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:avg_rep_time_days, doc:"Average replenishment time in days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:min_rep_time_days, doc:"Minimum replenishment time in days", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:max_rep_time_days, doc:"Maximum replenishment time in days", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:last_received_date, doc:"Date of most recent order receipt", type:{ base:timestamp, timestamp_mask:"yyyy-MM-dd", nullable:true } },
    { name:last_30d_order, doc:"Daily order rate over last 30 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:last_60d_order, doc:"Daily order rate over last 60 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:last_90d_order, doc:"Daily order rate over last 90 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:last_120d_order, doc:"Daily order rate over last 120 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:last_150d_order, doc:"Daily order rate over last 150 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:last_180d_order, doc:"Daily order rate over last 180 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:last_365d_order, doc:"Daily order rate over last 365 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:open_order_count, doc:"Number of open purchase orders", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:back_order_qty, doc:"Back order quantity", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:nearest_po_number, doc:"Nearest open PO number", type:{ base:string, max_length:100, nullable:true } },
    { name:order_inaction_flag, doc:"1 if part below MIN with no open orders, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:trend_ratio, doc:"Trend ratio: (30d rate - 150d rate) / 150d rate", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:consumed_150d, doc:"Total consumption over 150 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:consumption_rate_150d, doc:"Daily consumption rate over 150 days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:replenishment_demand_150d, doc:"Replenishment demand = rate * lead_time", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:coverage_150d, doc:"Coverage = MIN / replenishment_demand (capped at 1.0)", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:stockout_fraction_150d, doc:"Stockout fraction = 1 - coverage", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:stockout_days_per_cycle_150d, doc:"Stockout days per replenishment cycle", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:cycle_length_days_150d, doc:"Cycle length = (MAX - MIN) / consumption_rate", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:cycles_per_year_150d, doc:"Cycles per year = 365 / cycle_length", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:stockout_days_yr_min_150d, doc:"Annual stockout days from MIN setting", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:stockout_days_min_rep_150d, doc:"Stockout days using actual avg rep time", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:combined_stockout_days_yr_150d, doc:"Combined annual stockout days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:structural_risk_combo_criticality_150d, doc:"Structural risk score weighted by criticality", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:days_of_supply_150d, doc:"Days of supply = (on-hand + back order) / rate", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:depletion_date_150d, doc:"Projected depletion date", type:{ base:timestamp, timestamp_mask:"yyyy-MM-dd", nullable:true } },
    { name:projected_order_date_150d, doc:"Projected order date (depletion minus lead time)", type:{ base:timestamp, timestamp_mask:"yyyy-MM-dd", nullable:true } },
    { name:stockout_days_yr_rep_150d, doc:"Stockout days from rep time exceeding MIN-based days", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:adj_days_of_supply_150d, doc:"Adjusted days of supply (trend-adjusted)", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:is_stockout_no_po, doc:"1 if OH=0 and no PO, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:is_stockout_with_po, doc:"1 if OH=0 and PO exists, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:is_below_min_no_po, doc:"1 if 0<OH<=MIN and no PO, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:is_below_min_with_po, doc:"1 if 0<OH<=MIN and PO exists, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:situational_score_150d, doc:"Situational score (tiered 0-1 scale based on inventory status)", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:situational_score_criticality_150d, doc:"Situational score weighted by criticality", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:overall_score_criticality_150d, doc:"Overall score = situational + structural (criticality-weighted)", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:ar_region, doc:"Facility region from rts_rcc_facilities", type:{ base:string, max_length:100, nullable:true } },
    { name:subregion, doc:"Facility subregion", type:{ base:string, max_length:100, nullable:true } },
    { name:type, doc:"Facility type", type:{ base:string, max_length:100, nullable:true } },
    { name:subtype, doc:"Facility subtype", type:{ base:string, max_length:100, nullable:true } },
    { name:is_rspl_apn, doc:"1 if part is from Layer 1 (RSPL), 0 otherwise", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:in_score_base, doc:"1 if part is in Layer 2 score base, 0 otherwise", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:product, doc:"Product type (USP, URL Rev C/C2/D) from Layer 1 or Layer 2 fallback", type:{ base:string, max_length:100, nullable:true } },
    { name:mpn, doc:"Manufacturer part number from Layer 1", type:{ base:string, max_length:200, nullable:true } },
    { name:catalogue_reference, doc:"Catalogue reference from Layer 1", type:{ base:string, max_length:200, nullable:true } },
    { name:sto_prefmanufactpart, doc:"Preferred manufacturer part from APM setup", type:{ base:string, max_length:200, nullable:true } },
    { name:apm_mpn, doc:"APM MPN from r5stock (sto_prefmanufactpart)", type:{ base:string, max_length:200, nullable:true } },
    { name:sto_min_lev, doc:"MIN level from APM setup", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:sto_leadtime, doc:"Lead time from APM setup", type:{ base:decimal, max_scale:4, max_precision:15, nullable:true } },
    { name:not_set_up_in_apm, doc:"1 if MPN not set up in APM, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:missing_mpn_network, doc:"1 if MPN missing from network, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:missing_mpn_site, doc:"1 if MPN missing from site, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:missing_crn, doc:"1 if catalogue reference missing, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:incorrect_mpn, doc:"1 if MPN is incorrect, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:multiple_apns, doc:"1 if MPN maps to multiple APNs, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:incorrect_apm_setup, doc:"1 if any APM setup problem exists, else 0", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_missing_mpn_network_count, doc:"Site+product count of MPNs missing from network", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_missing_mpn_site_count, doc:"Site+product count of MPNs missing from site", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_missing_crn_count, doc:"Site+product count of MPNs with missing catalogue reference", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_incorrect_mpn_count, doc:"Site+product count of incorrect MPNs", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_multiple_apns_count, doc:"Site+product count of MPNs with multiple APNs", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_no_apn_mapped_count, doc:"Site+product count of MPNs with no APN mapped", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_incorrect_apm_setup_count, doc:"Site+product count of MPNs with any APM setup problem", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_incorrect_apm_setup_penalty, doc:"Site+product penalty (5 if >=50 MPNs with APM issues, else 0)", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_no_apn_mapped_penalty, doc:"Site+product penalty (5 if >=10 MPNs with no APN, else 0)", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:site_not_set_up_mpn_count, doc:"Site-level count of MPNs not set up in APM", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:site_apm_penalty, doc:"Site-level APM penalty (5 if >=10 MPNs not set up, else 0)", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:not_set_up_mpn_count, doc:"Site+product count of MPNs not set up in APM", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } },
    { name:sp_part_count, doc:"Site+product total part count (for scaling scores)", type:{ base:int, min_value:-2147483648, max_value:2147483647, nullable:true } }
  ]
}
